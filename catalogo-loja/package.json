{
  "name": "catalogo-loja",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo de produtos com painel administrativo rodando em Cloudflare Workers + D1 + R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply catalogo-db --local",
    "db:remoto": "wrangler d1 migrations apply catalogo-db --remote",
    "r2:criar": "wrangler r2 bucket create catalogo-imagens",
    "d1:criar": "wrangler d1 create catalogo-db"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
